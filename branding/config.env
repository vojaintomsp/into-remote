# INTO Remote - build configuration. Server address and key are NOT kept here:
# the build takes them from the environment (GitHub secrets INTO_SERVER_HOST, INTO_SERVER_KEY).
RUSTDESK_VERSION=1.5.0
APP_NAME="INTO-Remote"
# human-readable name used in UI texts and file descriptions (the technical app name above must match [a-zA-Z0-9-]+ since RustDesk 1.5.0)
DISPLAY_NAME="INTO Remote"
COMPANY="INTO d.o.o. Beograd"
HOMEPAGE="https://www.intomsp.com"
DOWNLOAD_URL="https://www.intomsp.com/remote/"
