{
  "app-name": "INTO Remote",
  "conn-type": "incoming",
  "enable-lan-discovery": "N",
  "override-settings": {
    "custom-rendezvous-server": "@SERVER_HOST@",
    "key": "@SERVER_KEY@",
    "enable-check-update": "N",
    "allow-auto-update": "N",
    "approve-mode": "password",
    "verification-method": "use-permanent-password",
    "hide-server-settings": "Y"
  },
  "default-settings": {
    "enable-lan-discovery": "N"
  }
}
